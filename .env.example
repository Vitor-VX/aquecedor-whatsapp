PORT=3100
MONGODB_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority"
PUBLIC_BASE_URL="https://aquecedor.seudominio.com"
UAZAPI_SERVER_URL="https://seu-subdominio.uazapi.com"
UAZAPI_ADMIN_TOKEN=""
INSTANCE_TOKEN_ENCRYPTION_KEY="troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
